-- If true, all messages in the bot's DMs will be printed to console.
LOG_MOTTBOT_MESSAGES = true

-- List of allowed users for !setchannel and !echo. Leave nil to allow anyone to use them.
ECHO_ALLOWED_USERS = nil

-- List of allowed users for !reload and !debug. Leave nil to allow anyone to use them.
DEBUG_ALLOWED_USERS = nil

-- Authorization settings for the !vc and !vcr commands
-- Set VC_AUTH_TYPE to "whitelist" or "blacklist" to ban specific users from using !vc and !vcr
-- Set VC_AUTH_USERS to a table of user IDs (as strings), which will be either whitelisted or blacklisted as defined by VC_AUTH_TYPE
-- This will prevent a user from using the command unless they're on the whitelist/not on the blacklist
VC_AUTH_TYPE = nil
VC_AUTH_USERS = {}

-- Authorization settings for the !start command
-- Works the same as VC_AUTH_TYPE and VC_AUTH_USERS above, with one exception:
-- The start command will never ignore someone included in the body of the message, as long as the person who used the command is allowed to
START_AUTH_TYPE = nil
START_AUTH_USERS = {}

-- List of users ignored by the !vc and !vcr commands
-- Set this to a table of user IDs (as strings). Those users will be ignored if they happen to be in call when someone else uses !vc or !vcr
VC_IGNORE_USERS = {}